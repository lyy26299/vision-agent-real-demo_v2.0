# Qwen Realtime API 配置（本地入口必需）
# 获取 API 密钥：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# 国际区域密钥请改为：wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# 本地教练记忆（可选；默认值可直接使用）
# 用户标识用于隔离不同训练者的长期记录，不要填入 API 密钥。
COACH_USER_ID=local-user
# SQLite 事实账本路径；相对路径以项目根目录为基准。
COACH_MEMORY_DB=coach_memory.sqlite3

# 推理设备与语音模型（可选）
YOLO_DEVICE=mps
# QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
# QWEN_VOICE=Ethan

# 旧版 Stream/Gemini 入口已不再由 agent_local.py 使用；如需兼容旧脚本，可在本地额外设置，
# 但不要把这些密钥提交到仓库。

# 日志级别
LOG_LEVEL=INFO
