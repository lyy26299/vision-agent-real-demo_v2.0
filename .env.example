# Stream API 配置
# 获取免费 API 密钥：https://getstream.io
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_secret_here

# Gemini API 配置（推荐）
# 获取 API 密钥：https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Qwen API 配置（使用 Qwen 时需要）
# 获取 API 密钥：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# 国际区域密钥请改为：wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# OpenAI API 配置（可选）
# 如果使用 OpenAI 而不是 Gemini
# OPENAI_API_KEY=your_openai_api_key_here

# 日志级别
LOG_LEVEL=INFO
